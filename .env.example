# Preferred: fetch secrets from AWS Secrets Manager instead (recommended in
# production). Set this and leave DISCORD_TOKEN / SPOTIFY_*_USERNAME /
# SPOTIFY_*_PASSWORD out of this file entirely.
SECRETS_MANAGER_SECRET_ID=discord-music-bot/credentials

# From infra/create-interaction-queue.sh -- lambda/wake_sleep.py relays
# /connect, /disconnect (anything besides /wake and /sleep) here since
# Discord only delivers interactions to the bot's gateway OR the Lambda
# Interactions Endpoint URL, never both.
INTERACTIONS_QUEUE_URL=

# Local-dev-only fallback (used when SECRETS_MANAGER_SECRET_ID is unset):
DISCORD_TOKEN=

# Not read by the bot itself (application_id comes from each interaction's
# own payload at runtime, and DISCORD_PUBLIC_KEY is only used by the
# separately-deployed Lambda -- see infra/deploy-lambda.sh) -- kept here so
# infra/setup-instance.sh's guided setup has somewhere to save them.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

IDLE_SHUTDOWN_MINUTES=20
IDLE_CHECK_INTERVAL_SECONDS=30
ENABLE_AUTO_SHUTDOWN=true

LIBRESPOT_BIN=/usr/local/bin/librespot
PIPE_DIR=/tmp/librespot

# How many self-serve Spotify slots exist. /link claims a free one,
# /delete-slot frees one back up -- see bot/slot_store.py.
MAX_SLOTS=5
# Where slot names/password hashes/claim state are persisted. Must be
# persistent storage (same volume as LIBRESPOT_CACHE_DIR), not /tmp.
SLOT_METADATA_PATH=/opt/discord-bot/librespot-cache/slots.json
# Local port librespot's --enable-oauth binds during a /link -- never needs
# to be reachable from outside the box, see bot/spotify_link.py.
LINK_OAUTH_PORT=5588
# Seconds a friend has between /link and /link-finish before the slot
# reverts to free.
LINK_TIMEOUT_SECONDS=900
