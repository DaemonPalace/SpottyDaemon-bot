{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SelfStopOnly",
      "Effect": "Allow",
      "Action": "ec2:StopInstances",
      "Resource": "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": { "ec2:ResourceTag/Name": "discord-music-bot" }
      }
    }
  ]
}
