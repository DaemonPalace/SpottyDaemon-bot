# Core (required everywhere) -----------------------------------------------
# If you're using the cockpit UI (supervisor/main.py), skip this file
# entirely -- its first-run setup wizard writes DISCORD_TOKEN and API_TOKEN
# for you. Edit these by hand only if you're running bot/main.py directly.

DISCORD_TOKEN=

# Self-host defaults (no action needed) --------------------------------------
# These all have sane defaults for a plain self-hosted/standalone install.
# Uncomment only to change them.

# HOST_CONTROLLER=noop          # "noop" (default) or "ec2" (legacy AWS)
# ENABLE_AUTO_SHUTDOWN=true
# IDLE_SHUTDOWN_MINUTES=20
# IDLE_CHECK_INTERVAL_SECONDS=30
# LIBRESPOT_BIN=librespot
# PIPE_DIR=/tmp/librespot
# LIBRESPOT_CACHE_DIR=/opt/discord-bot/librespot-cache
# MAX_SLOTS=5
# LINK_OAUTH_PORT=5588
# LINK_TIMEOUT_SECONDS=900

# Diagnostics API (bot/api.py) -- loopback-only and unauthenticated by
# default. Set API_TOKEN before exposing this beyond localhost.
# API_HOST=127.0.0.1
# API_PORT=8787
# API_TOKEN=

# Local dev only: syncs slash commands to this guild instantly instead of
# globally (which can take up to an hour to propagate). Set to your test
# server's ID (right-click the server icon in Discord -> Copy Server ID,
# needs Developer Mode on).
# DEV_GUILD_ID=

# Spotify Web API access (bot/spotify_web_api.py) -- optional, only needed
# for /link-web-api (now-playing / queue features). Register your own app
# at developer.spotify.com and add SPOTIFY_WEB_API_REDIRECT_URI there.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_WEB_API_REDIRECT_URI=http://127.0.0.1:5589/callback

# Per-slot device names (SPOTIFY_<N>_DEVICE_NAME, N = 1..MAX_SLOTS), optional:
# SPOTIFY_1_DEVICE_NAME=discord-bot-1

# Cockpit UI supervisor (supervisor/main.py) -- optional, only if you're
# running the web UI. See it write DISCORD_TOKEN/API_TOKEN above for you.
# SUPERVISOR_HOST=127.0.0.1
# SUPERVISOR_PORT=8080

# Legacy AWS mode (only if HOST_CONTROLLER=ec2 or you're wiring up Lambda) ---

# SECRETS_MANAGER_SECRET_ID=
# INTERACTIONS_QUEUE_URL=
